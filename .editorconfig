root = true
[*]
indent_style = space
indent_size = 4
insert_final_newline = true
charset = utf-8
[*.{cs,xaml}]
indent_size = 4
[*.{csproj,props,targets,json,xml,wxs}]
indent_size = 2
[*.{cpp,h,hpp,txt}]
indent_size = 4
[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
