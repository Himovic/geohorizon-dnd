<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- GeoVision Pro dark scientific theme -->
    <Color x:Key="BackgroundColor">#171B24</Color>
    <Color x:Key="SecondaryBackgroundColor">#202633</Color>
    <Color x:Key="PanelColor">#252D3A</Color>
    <Color x:Key="AccentColor">#3D8BDB</Color>
    <Color x:Key="Accent2Color">#20B8A6</Color>
    <Color x:Key="TextColor">#E8EDF4</Color>
    <Color x:Key="MutedTextColor">#9AA6B8</Color>
    <Color x:Key="BorderColor">#343E50</Color>
    <Color x:Key="HoverColor">#2E3848</Color>
    <Color x:Key="InputColor">#1C212C</Color>
    <Color x:Key="WarningColor">#F2B84B</Color>
    <Color x:Key="ErrorColor">#F0616D</Color>
    <Color x:Key="SuccessColor">#4CC38A</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#3D8BDB" Opacity="0.35"/>
    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#10131A"/>
</ResourceDictionary>
