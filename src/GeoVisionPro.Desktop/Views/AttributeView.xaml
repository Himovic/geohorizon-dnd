<UserControl x:Class="GeoVisionPro.Desktop.Views.AttributeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GeoVisionPro.Desktop.Controls">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ScrollViewer Background="{DynamicResource PanelBrush}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6">
                <TextBlock Text="Input volume" Style="{StaticResource SectionHeader}"/>
                <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding Input}" DisplayMemberPath="Name"/>
                <TextBlock Text="Attribute" Style="{StaticResource SectionHeader}"/>
                <ComboBox ItemsSource="{Binding Attributes}" SelectedItem="{Binding Attribute}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock><Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}"/><Run Text="  "/><Run Text="{Binding DisplayName, Mode=OneWay}"/></TextBlock></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ItemsControl ItemsSource="{Binding Parameters}"/>
                <Button Content="Compute attribute volume" Style="{StaticResource AccentButton}" Command="{Binding ComputeVolumeCommand}" Margin="2,6"/>
                <TextBlock Text="Horizon attribute map" Style="{StaticResource SectionHeader}"/>
                <ComboBox ItemsSource="{Binding Horizons}" SelectedItem="{Binding Horizon}" DisplayMemberPath="Name"/>
                <ComboBox ItemsSource="{Binding WindowModes}" SelectedItem="{Binding WindowMode}"/>
                <ComboBox ItemsSource="{Binding Statistics}" SelectedItem="{Binding Statistic}"/>
                <DockPanel><TextBlock Text="Above ms" Width="80" VerticalAlignment="Center"/><TextBox Text="{Binding AboveMs}"/></DockPanel>
                <DockPanel><TextBlock Text="Below ms" Width="80" VerticalAlignment="Center"/><TextBox Text="{Binding BelowMs}"/></DockPanel>
                <TextBlock Text="Base horizon (between-horizons mode)" Style="{StaticResource Muted}"/>
                <ComboBox ItemsSource="{Binding Horizons}" SelectedItem="{Binding BaseHorizon}" DisplayMemberPath="Name"/>
                <Button Content="Extract map" Command="{Binding ExtractMapCommand}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="{DynamicResource SecondaryBackgroundBrush}">
                <TextBlock Text="Preview inline" VerticalAlignment="Center" Margin="6,0" Style="{StaticResource Muted}"/>
                <Slider Width="220" Minimum="{Binding MinInline}" Maximum="{Binding MaxInline}" Value="{Binding PreviewInline, Delay=300}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                <TextBox Width="60" Text="{Binding PreviewInline, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Info}" TextWrapping="Wrap" Margin="6,3" Style="{StaticResource Muted}"/>
            <c:SeismicSectionControl x:Name="Preview"/>
        </DockPanel>
    </Grid>
</UserControl>
