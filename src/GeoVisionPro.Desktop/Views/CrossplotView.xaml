<UserControl x:Class="GeoVisionPro.Desktop.Views.CrossplotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ScrollViewer Background="{DynamicResource PanelBrush}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6">
                <TextBlock Text="Data" Style="{StaticResource SectionHeader}"/>
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}"/>
                <TextBlock Text="Wells" Style="{StaticResource Muted}"/>
                <ItemsControl ItemsSource="{Binding Wells}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <DockPanel><TextBlock Text="X curve" Width="70" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding CurveNames}" SelectedItem="{Binding XCurve}"/></DockPanel>
                <DockPanel><TextBlock Text="Y curve" Width="70" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding CurveNames}" SelectedItem="{Binding YCurve}"/></DockPanel>
                <DockPanel><TextBlock Text="Colour" Width="70" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding CurveNames}" SelectedItem="{Binding ZCurve}"/></DockPanel>
                <DockPanel><TextBlock Text="MD from/to" Width="70" VerticalAlignment="Center"/><UniformGrid Columns="2"><TextBox Text="{Binding DepthMin}"/><TextBox Text="{Binding DepthMax}"/></UniformGrid></DockPanel>
                <TextBlock Text="Volumes" Style="{StaticResource Muted}"/>
                <DockPanel><TextBlock Text="X volume" Width="70" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding XVolume}" DisplayMemberPath="Name"/></DockPanel>
                <DockPanel><TextBlock Text="Y volume" Width="70" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding YVolume}" DisplayMemberPath="Name"/></DockPanel>
                <DockPanel><TextBlock Text="Colour" Width="70" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding ZVolume}" DisplayMemberPath="Name"/></DockPanel>
                <DockPanel><TextBlock Text="Decimation" Width="70" VerticalAlignment="Center"/><TextBox Text="{Binding InlineDecimation}"/></DockPanel>
                <Button Content="Load crossplot" Style="{StaticResource AccentButton}" Command="{Binding LoadCommand}"/>
                <CheckBox Content="Regression line" IsChecked="{Binding ShowRegression}"/>
                <TextBlock Text="Selection and facies" Style="{StaticResource SectionHeader}"/>
                <ToggleButton Content="Draw polygon (click points)" IsChecked="{Binding Selecting}" Style="{StaticResource ToolButton}" Padding="6,4"/>
                <UniformGrid Columns="2">
                    <Button Content="Close polygon" Command="{Binding ClosePolygonCommand}"/>
                    <Button Content="Clear" Command="{Binding ClearSelectionCommand}"/>
                </UniformGrid>
                <DockPanel><TextBlock Text="Facies" Width="70" VerticalAlignment="Center"/><TextBox Text="{Binding FaciesName}"/></DockPanel>
                <UniformGrid Columns="2">
                    <Button Content="Assign facies" Command="{Binding AssignFaciesCommand}"/>
                    <Button Content="Classify" Command="{Binding ClassifyCommand}"/>
                </UniformGrid>
                <Button Content="Write FACIES logs" Command="{Binding WriteFaciesLogsCommand}"/>
                <TextBlock Text="Clustering" Style="{StaticResource SectionHeader}"/>
                <DockPanel><TextBlock Text="k" Width="70" VerticalAlignment="Center"/><TextBox Text="{Binding Clusters}"/></DockPanel>
                <Button Content="k-means" Command="{Binding ClusterCommand}"/>
                <TextBlock Text="Export" Style="{StaticResource SectionHeader}"/>
                <UniformGrid Columns="3">
                    <Button Content="CSV" Command="{Binding ExportCsvCommand}"/>
                    <Button Content="PNG" Click="Png_Click"/>
                    <Button Content="Save" Command="{Binding SaveDefinitionCommand}"/>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Column="1">
            <TextBox DockPanel.Dock="Bottom" Height="56" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding Stats, Mode=OneWay}"/>
            <sp:WpfPlot x:Name="Plot"/>
        </DockPanel>
    </Grid>
</UserControl>
