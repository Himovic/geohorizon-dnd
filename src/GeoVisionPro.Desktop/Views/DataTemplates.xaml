<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GeoVisionPro.Desktop.ViewModels"
                    xmlns:v="clr-namespace:GeoVisionPro.Desktop.Views">
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <!-- document view-models are rendered by their views through implicit data templates -->
    <DataTemplate DataType="{x:Type vm:SeismicViewerViewModel}"><v:SeismicViewerView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChartViewModel}"><v:ChartView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MapViewModel}"><v:MapView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:Scene3DViewModel}"><v:Scene3DView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:VtkVolumeViewModel}"><v:VtkVolumeView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:WellLogViewModel}"><v:WellLogView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CheckshotViewModel}"><v:CheckshotView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:WellTieViewModel}"><v:WellTieView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PetrophysicsViewModel}"><v:PetrophysicsView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:RockPhysicsViewModel}"><v:RockPhysicsView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProcessingViewModel}"><v:ProcessingView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:WorkflowViewModel}"><v:WorkflowView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:VelocityAnalysisViewModel}"><v:VelocityAnalysisView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AttributeViewModel}"><v:AttributeView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:InversionViewModel}"><v:InversionView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AvoViewModel}"><v:AvoView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CrossplotViewModel}"><v:CrossplotView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:GeoModelViewModel}"><v:GeoModelView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SegyBrowserViewModel}"><v:SegyBrowserView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportViewModel}"><v:ReportView/></DataTemplate>

    <!-- generated parameter editor -->
    <DataTemplate DataType="{x:Type vm:ParameterItemViewModel}">
        <Grid Margin="0,2" ToolTip="{Binding ToolTip}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}"/>
            <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue}" Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
