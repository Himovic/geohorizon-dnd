<UserControl x:Class="GeoVisionPro.Desktop.Views.GeoModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ScrollViewer Background="{DynamicResource PanelBrush}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6">
                <TextBlock Text="Structural framework" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Horizons (top to base, auto-ordered)" Style="{StaticResource Muted}"/>
                <ItemsControl ItemsSource="{Binding Horizons}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <DockPanel><TextBlock Text="Layers per zone" Width="120" VerticalAlignment="Center"/><TextBox Text="{Binding LayersPerZone}"/></DockPanel>
                <DockPanel><TextBlock Text="Decimation" Width="120" VerticalAlignment="Center"/><TextBox Text="{Binding Decimation}"/></DockPanel>
                <TextBlock Text="Property modelling" Style="{StaticResource SectionHeader}"/>
                <DockPanel><TextBlock Text="Well curve" Width="120" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding CurveNames}" SelectedItem="{Binding Property}"/></DockPanel>
                <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}"/>
                <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding VariogramModel}"/>
                <DockPanel><TextBlock Text="Range (m)" Width="120" VerticalAlignment="Center"/><TextBox Text="{Binding Range}"/></DockPanel>
                <DockPanel><TextBlock Text="Nugget (of sill 1)" Width="120" VerticalAlignment="Center"/><TextBox Text="{Binding Nugget}"/></DockPanel>
                <Button Content="Build model" Style="{StaticResource AccentButton}" Command="{Binding BuildCommand}"/>
                <TextBlock Text="Display layer" Style="{StaticResource SectionHeader}"/>
                <TextBox Text="{Binding DisplayLayer}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Column="1">
            <TextBox DockPanel.Dock="Bottom" Height="90" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding Report, Mode=OneWay}"/>
            <Image x:Name="LayerImage" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </DockPanel>
    </Grid>
</UserControl>
