<UserControl x:Class="GeoVisionPro.Desktop.Views.InversionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ScrollViewer Background="{DynamicResource PanelBrush}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6">
                <TextBlock Text="1. Seismic and wavelet" Style="{StaticResource SectionHeader}"/>
                <ComboBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding Seismic}" DisplayMemberPath="Name"/>
                <CheckBox Content="Use Ricker wavelet" IsChecked="{Binding UseRicker}"/>
                <DockPanel><TextBlock Text="Ricker Hz" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding RickerFrequency}"/></DockPanel>
                <ComboBox ItemsSource="{Binding ProjectWavelets}" SelectedItem="{Binding Wavelet}" DisplayMemberPath="Name" ToolTip="Project wavelet (e.g. from a well tie)"/>
                <TextBlock Text="2. Wells (calibrated) and horizons" Style="{StaticResource SectionHeader}"/>
                <ItemsControl ItemsSource="{Binding Wells}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <ItemsControl ItemsSource="{Binding Horizons}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="3. Low-frequency model" Style="{StaticResource SectionHeader}"/>
                <DockPanel><TextBlock Text="High-cut Hz" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding LfCutoff}"/></DockPanel>
                <Button Content="Build LF model volume" Command="{Binding BuildModelVolumeCommand}"/>
                <TextBlock Text="4. Inversion parameters" Style="{StaticResource SectionHeader}"/>
                <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}"/>
                <DockPanel><TextBlock Text="Seismic scaler" Width="110" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Estimate" Command="{Binding EstimateScaleCommand}"/><TextBox Text="{Binding Scale}"/></DockPanel>
                <DockPanel><TextBlock Text="Model weight" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding ModelWeight}"/></DockPanel>
                <DockPanel><TextBlock Text="Constraint %" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding Constraint}"/></DockPanel>
                <DockPanel><TextBlock Text="Iterations" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding Iterations}"/></DockPanel>
                <DockPanel><TextBlock Text="Sparsity λ" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding Sparsity}"/></DockPanel>
                <DockPanel><TextBlock Text="Merge Hz" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding Merge}"/></DockPanel>
                <TextBlock Text="5. QC and run" Style="{StaticResource SectionHeader}"/>
                <ComboBox ItemsSource="{Binding Wells}" SelectedItem="{Binding QcWell}" DisplayMemberPath="Name"/>
                <Button Content="Invert trace at QC well" Command="{Binding QcAtWellCommand}"/>
                <TextBox Text="{Binding OutputName}"/>
                <Button Content="Run inversion on volume" Style="{StaticResource AccentButton}" Command="{Binding RunCommand}"/>
                <TextBlock Text="Pre-stack simultaneous inversion" Style="{StaticResource SectionHeader}"/>
                <ComboBox ItemsSource="{Binding GatherSets}" SelectedItem="{Binding Gathers}" DisplayMemberPath="Name"/>
                <DockPanel><TextBlock Text="IL / XL" Width="110" VerticalAlignment="Center"/><UniformGrid Columns="2"><TextBox Text="{Binding GInline}"/><TextBox Text="{Binding GCrossline}"/></UniformGrid></DockPanel>
                <TextBlock Text="RMS velocity (NMO, angles)" Style="{StaticResource Muted}"/>
                <TextBox Text="{Binding VelocityFunction}"/>
                <Button Content="Invert gather (Ip, Is, ρ)" Command="{Binding RunPrestackAtLocationCommand}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Column="1">
            <TextBox DockPanel.Dock="Bottom" Height="70" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding PrestackText, Mode=OneWay}"/>
            <TextBox DockPanel.Dock="Bottom" Height="60" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding QcText, Mode=OneWay}"/>
            <UniformGrid Columns="2">
                <sp:WpfPlot x:Name="QcPlot"/>
                <sp:WpfPlot x:Name="ElasticPlot"/>
            </UniformGrid>
        </DockPanel>
    </Grid>
</UserControl>
