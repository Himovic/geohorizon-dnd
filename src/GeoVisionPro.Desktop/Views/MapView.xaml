<UserControl x:Class="GeoVisionPro.Desktop.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GeoVisionPro.Desktop.Controls">
    <DockPanel Background="{DynamicResource BackgroundBrush}">
        <WrapPanel DockPanel.Dock="Top" Background="{DynamicResource SecondaryBackgroundBrush}">
            <TextBlock Text="Horizon" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="6,0,2,0"/>
            <ComboBox Width="170" ItemsSource="{Binding Horizons}" SelectedItem="{Binding SelectedHorizon}" DisplayMemberPath="Name"/>
            <TextBlock Text="Map" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="6,0,2,0"/>
            <ComboBox Width="190" ItemsSource="{Binding MapAttributes}" SelectedItem="{Binding MapAttribute}"/>
            <ComboBox Width="150" ItemsSource="{Binding ColorMapNames}" SelectedItem="{Binding ColorMapName}"/>
            <ToggleButton Content="Draw arbitrary line" IsChecked="{Binding DrawArbitrary}" Style="{StaticResource ToolButton}" Padding="8,3"
                          ToolTip="Click vertices on the map, double-click to finish; the arbitrary section opens in a new viewer."/>
            <Button Content="Zoom to fit" Click="Fit_Click"/>
            <Button Content="Export PNG" Click="Export_Click"/>
        </WrapPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SecondaryBackgroundBrush}" Padding="6,2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Legend}" Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding Readout}" FontFamily="{StaticResource MonoFont}"/>
            </DockPanel>
        </Border>
        <c:MapControl x:Name="Map"/>
    </DockPanel>
</UserControl>
