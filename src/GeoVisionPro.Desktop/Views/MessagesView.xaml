<UserControl x:Class="GeoVisionPro.Desktop.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{DynamicResource PanelBrush}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="Clear" Command="{Binding ClearCommand}" Padding="6,1"/>
        </StackPanel>
        <ListView x:Name="List" ItemsSource="{Binding Items}" FontFamily="{StaticResource MonoFont}" FontSize="11.5">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock x:Name="T" TextWrapping="NoWrap">
                        <Run Text="{Binding Time, StringFormat=HH:mm:ss, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}"/>
                        <Run x:Name="L" Text="{Binding Level, Mode=OneWay}"/>
                        <Run Text="{Binding Source, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                        <Run Text="{Binding Text, Mode=OneWay}"/>
                    </TextBlock>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter TargetName="L" Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="Error"><Setter TargetName="L" Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="Success"><Setter TargetName="L" Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</UserControl>
