<UserControl x:Class="GeoVisionPro.Desktop.Views.ProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GeoVisionPro.Desktop.Controls"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <DockPanel Background="{DynamicResource PanelBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="6">
                <TextBlock Text="Input dataset" Style="{StaticResource SectionHeader}"/>
                <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding Input}" DisplayMemberPath="Name"/>
                <TextBlock Text="Operation" Style="{StaticResource SectionHeader}"/>
                <ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock><Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}"/><Run Text="  "/><Run Text="{Binding DisplayName, Mode=OneWay}"/></TextBlock></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding SelectedOperation.Description}" Style="{StaticResource Muted}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add step" Command="{Binding AddStepCommand}"/>
                    <Button Content="Remove" Command="{Binding RemoveStepCommand}"/>
                    <Button Content="▲" Command="{Binding MoveUpCommand}"/>
                    <Button Content="▼" Command="{Binding MoveDownCommand}"/>
                </StackPanel>
                <TextBlock Text="Sequence" Style="{StaticResource SectionHeader}"/>
                <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" Height="140">
                    <ListBox.ItemTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Enabled}" Content="{Binding DisplayName}"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Parameters" Style="{StaticResource SectionHeader}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="6">
                <TextBlock Text="Output name" Style="{StaticResource Muted}"/>
                <TextBox Text="{Binding OutputName}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Run on dataset" Style="{StaticResource AccentButton}" Command="{Binding RunCommand}"/>
                    <Button Content="Save as workflow" Command="{Binding SaveAsWorkflowCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6,0">
                <ItemsControl ItemsSource="{Binding SelectedStep.Parameters}"/>
            </ScrollViewer>
        </DockPanel>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="{DynamicResource SecondaryBackgroundBrush}">
                <TextBlock Text="Preview inline" VerticalAlignment="Center" Margin="6,0" Style="{StaticResource Muted}"/>
                <Slider Width="200" Minimum="{Binding PreviewMin}" Maximum="{Binding PreviewMax}" Value="{Binding PreviewPosition, Delay=300}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                <TextBox Width="60" Text="{Binding PreviewPosition, UpdateSourceTrigger=LostFocus}"/>
                <TextBlock Text="{Binding PreviewInfo}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <sp:WpfPlot x:Name="Spectrum" DockPanel.Dock="Bottom" Height="190"/>
            <UniformGrid Columns="2">
                <c:SeismicSectionControl x:Name="BeforeView"/>
                <c:SeismicSectionControl x:Name="AfterView"/>
            </UniformGrid>
        </DockPanel>
    </Grid>
</UserControl>
