<UserControl x:Class="GeoVisionPro.Desktop.Views.SegyBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GeoVisionPro.Desktop.Controls">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ScrollViewer Background="{DynamicResource PanelBrush}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                <TextBlock Text="Trace header keys (byte, 1-based)" Style="{StaticResource SectionHeader}"/>
                <DockPanel><TextBlock Text="Inline" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding InlineByte}"/></DockPanel>
                <DockPanel><TextBlock Text="Crossline / CDP" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding CrosslineByte}"/></DockPanel>
                <DockPanel><TextBlock Text="CDP X" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding CdpXByte}"/></DockPanel>
                <DockPanel><TextBlock Text="CDP Y" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding CdpYByte}"/></DockPanel>
                <DockPanel><TextBlock Text="Coord. scalar" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding ScalarByte}"/></DockPanel>
                <DockPanel><TextBlock Text="Offset" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding OffsetByte}"/></DockPanel>
                <TextBlock Text="Overrides" Style="{StaticResource SectionHeader}"/>
                <DockPanel><TextBlock Text="Sample format" Width="110" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding FormatOverride}"/></DockPanel>
                <DockPanel><TextBlock Text="dt ms (0 = header)" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding SampleIntervalOverrideMs}"/></DockPanel>
                <UniformGrid Columns="2">
                    <Button Content="Re-inspect" Command="{Binding InspectCommand}"/>
                    <Button Content="Scan geometry" Command="{Binding ScanCommand}"/>
                </UniformGrid>
                <TextBlock Text="Import" Style="{StaticResource SectionHeader}"/>
                <DockPanel><TextBlock Text="Dataset name" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding DatasetName}"/></DockPanel>
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" ToolTip="Link: memory-mapped access to the original file. Copy: compressed chunked (Zarr) store in the project, recommended for large volumes."/>
                <CheckBox Content="Gathers are angle gathers (offset field = angle)" IsChecked="{Binding AngleGathers}"/>
                <Button Content="Import into project" Style="{StaticResource AccentButton}" Command="{Binding ImportCommand}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding ScanReport}" TextWrapping="Wrap" Margin="0,6" Style="{StaticResource Muted}"/>
            </StackPanel>
        </ScrollViewer>
        <TabControl Grid.Column="1">
            <TabItem Header="Textual header">
                <TextBox Text="{Binding TextHeader, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </TabItem>
            <TabItem Header="Binary header">
                <DataGrid ItemsSource="{Binding BinaryTable}" AutoGenerateColumns="True" IsReadOnly="True"/>
            </TabItem>
            <TabItem Header="Trace headers">
                <DataGrid ItemsSource="{Binding TraceTable}" AutoGenerateColumns="True" IsReadOnly="True" FrozenColumnCount="1"/>
            </TabItem>
            <TabItem Header="Trace data">
                <c:SeismicSectionControl x:Name="TracePreview"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
