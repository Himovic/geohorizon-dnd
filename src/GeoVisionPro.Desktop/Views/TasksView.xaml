<UserControl x:Class="GeoVisionPro.Desktop.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{DynamicResource PanelBrush}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="Clear finished" Command="{Binding ClearFinishedCommand}" Padding="6,1"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/><ColumnDefinition Width="160"/><ColumnDefinition Width="80"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Grid.Column="1" Value="{Binding Progress}" Maximum="100" Margin="4,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Elapsed}" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Grid.Column="4" Text="{Binding Message}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}"/>
                        <Button Grid.Column="5" Content="Cancel" Command="{Binding CancelCommand}" Padding="6,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
