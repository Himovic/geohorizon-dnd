<UserControl x:Class="GeoVisionPro.Desktop.Views.VelocityAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GeoVisionPro.Desktop.Controls">
    <DockPanel Background="{DynamicResource BackgroundBrush}">
        <WrapPanel DockPanel.Dock="Top" Background="{DynamicResource SecondaryBackgroundBrush}">
            <ComboBox Width="180" ItemsSource="{Binding GatherSets}" SelectedItem="{Binding Gathers}" DisplayMemberPath="Name"/>
            <TextBlock Text="IL" VerticalAlignment="Center" Margin="6,0,2,0"/><TextBox Width="50" Text="{Binding Inline}"/>
            <TextBlock Text="XL" VerticalAlignment="Center" Margin="6,0,2,0"/><TextBox Width="50" Text="{Binding Crossline}"/>
            <TextBlock Text="V min/max/step" VerticalAlignment="Center" Margin="6,0,2,0"/>
            <TextBox Width="50" Text="{Binding VMin}"/><TextBox Width="50" Text="{Binding VMax}"/><TextBox Width="40" Text="{Binding VStep}"/>
            <Button Content="Compute semblance" Command="{Binding ComputeCommand}"/>
            <Button Content="Auto-pick" Command="{Binding AutoPickCommand}"/>
            <Button Content="Clear picks" Command="{Binding ClearPicksCommand}"/>
            <TextBlock Text="Stretch %" VerticalAlignment="Center" Margin="6,0,2,0"/><TextBox Width="40" Text="{Binding StretchMute}"/>
            <Button Content="NMO + stack all gathers" Style="{StaticResource AccentButton}" Command="{Binding StackCommand}"/>
        </WrapPanel>
        <DockPanel DockPanel.Dock="Bottom" Background="{DynamicResource SecondaryBackgroundBrush}">
            <TextBlock DockPanel.Dock="Left" Text="Velocity function t(s):v(m/s)" VerticalAlignment="Center" Margin="6,0" Style="{StaticResource Muted}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Info}" VerticalAlignment="Center" Margin="6,0" Style="{StaticResource Muted}"/>
            <TextBox Text="{Binding VelocityFunction}"/>
        </DockPanel>
        <UniformGrid Columns="3">
            <c:SeismicSectionControl x:Name="GatherView"/>
            <c:SeismicSectionControl x:Name="SemblanceView" ToolTip="Click to pick a velocity at a time"/>
            <c:SeismicSectionControl x:Name="NmoView"/>
        </UniformGrid>
    </DockPanel>
</UserControl>
