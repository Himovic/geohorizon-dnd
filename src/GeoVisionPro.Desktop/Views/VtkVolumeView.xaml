<UserControl x:Class="GeoVisionPro.Desktop.Views.VtkVolumeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GeoVisionPro.Desktop.Controls">
    <DockPanel Background="{DynamicResource BackgroundBrush}">
        <WrapPanel DockPanel.Dock="Top" Background="{DynamicResource SecondaryBackgroundBrush}">
            <TextBlock Text="Max dimension" VerticalAlignment="Center" Margin="6,0,2,0" Style="{StaticResource Muted}"/>
            <TextBox Width="50" Text="{Binding MaxDimension}"/>
            <TextBlock Text="Opacity" VerticalAlignment="Center" Margin="6,0,2,0" Style="{StaticResource Muted}"/>
            <Slider Width="120" Minimum="0.02" Maximum="1" Value="{Binding Opacity}"/>
            <CheckBox Content="Parallel projection" IsChecked="{Binding ParallelProjection}" Margin="6,0"/>
            <Button Content="Load / refresh volume" Click="Load_Click"/>
            <Button Content="Screenshot" Click="Shot_Click"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0" Style="{StaticResource Muted}"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding AvailabilityMessage}" TextWrapping="Wrap" Margin="6" Style="{StaticResource Muted}"/>
        <Grid x:Name="Host"/>
    </DockPanel>
</UserControl>
