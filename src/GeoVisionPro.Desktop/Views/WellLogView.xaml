<UserControl x:Class="GeoVisionPro.Desktop.Views.WellLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{DynamicResource BackgroundBrush}">
        <Border DockPanel.Dock="Left" Width="200" Background="{DynamicResource PanelBrush}">
            <StackPanel Margin="6">
                <TextBlock Text="Wells" Style="{StaticResource SectionHeader}"/>
                <ItemsControl ItemsSource="{Binding Wells}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><CheckBox Content="{Binding Well.Name}" IsChecked="{Binding IsSelected}"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Flatten on top" Style="{StaticResource SectionHeader}"/>
                <ComboBox ItemsSource="{Binding TopNames}" SelectedItem="{Binding FlattenOn}"/>
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Muted}" Text="Wheel: scroll. Ctrl+wheel: zoom. Drag: pan. Logs are synchronised in depth (or relative to the flattening top)."/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SecondaryBackgroundBrush}" Padding="6,2">
            <TextBlock Text="{Binding Readout}" FontFamily="{StaticResource MonoFont}"/>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Panel" Orientation="Horizontal"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
