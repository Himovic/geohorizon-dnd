<UserControl x:Class="GeoVisionPro.Desktop.Views.WorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
        <StackPanel Margin="6" Background="{DynamicResource PanelBrush}">
            <TextBlock Text="Saved workflows" Style="{StaticResource SectionHeader}"/>
            <ComboBox ItemsSource="{Binding Saved}" SelectedItem="{Binding SelectedSaved}" DisplayMemberPath="Name"/>
            <TextBlock Text="Name" Style="{StaticResource Muted}"/>
            <TextBox Text="{Binding Name}"/>
            <TextBlock Text="Description" Style="{StaticResource Muted}"/>
            <TextBox Text="{Binding Description}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
            <TextBlock Text="Add operation" Style="{StaticResource SectionHeader}"/>
            <ComboBox x:Name="CatalogBox" ItemsSource="{Binding Catalog}" SelectedItem="{Binding SelectedCatalogItem}"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Add" Command="{Binding AddCommand}"/>
                <Button Content="Remove" Command="{Binding RemoveCommand}"/>
                <Button Content="▲" Command="{Binding UpCommand}"/>
                <Button Content="▼" Command="{Binding DownCommand}"/>
            </StackPanel>
            <TextBlock Text="Execution" Style="{StaticResource SectionHeader}"/>
            <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding Input}" DisplayMemberPath="Name"/>
            <UniformGrid Columns="2">
                <Button Content="Run workflow" Style="{StaticResource AccentButton}" Command="{Binding ExecuteCommand}"/>
                <Button Content="Save to project" Command="{Binding SaveCommand}"/>
                <Button Content="Export JSON..." Command="{Binding ExportJsonCommand}"/>
                <Button Content="Import JSON..." Command="{Binding ImportJsonCommand}"/>
            </UniformGrid>
            <TextBlock Text="{Binding Validation}" TextWrapping="Wrap" Margin="2,6" Style="{StaticResource Muted}"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/>
        </StackPanel>
        <DockPanel Grid.Column="1" Margin="6">
            <TextBlock DockPanel.Dock="Top" Text="Workflow (executed top to bottom; consecutive processing steps run in one pass, attributes consume the previous output)" Style="{StaticResource Muted}"/>
            <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,1,1,1" CornerRadius="3" Padding="8,5" Margin="2,3" Background="{DynamicResource SecondaryBackgroundBrush}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="4,0"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <DockPanel Grid.Column="2" Margin="6" Background="{DynamicResource PanelBrush}">
            <TextBlock DockPanel.Dock="Top" Text="Step parameters" Style="{StaticResource SectionHeader}"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedStep.Description}" Style="{StaticResource Muted}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedStep.Parameters}"/></ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
